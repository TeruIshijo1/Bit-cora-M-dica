# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO (PLANTILLA .env.example) - MediReg HES
# ==============================================================================

# 1. Base de Datos Transaccional PostgreSQL Local
DATABASE_URL=postgresql://usuario:password@localhost:5432/hospital_escandon_db

# Solo pruebas de integración (nunca apuntar a hospital_escandon_db)
# APP_ENV=development | test | production
APP_ENV=development
# TEST_DATABASE_URL=postgresql://usuario_test:password@localhost:5432/hospital_escandon_test
# Opcional para crear la base dedicada si no se usa Testcontainers:
# TEST_DATABASE_ADMIN_URL=postgresql://administrador:password@localhost:5432/postgres

# 2. Conexión Hospitalaria Externa (SQL Server KH_HE vía Tailscale Mesh VPN)
KH_SERVER=127.0.0.1,1433
KH_DATABASE=KH_HE
KH_USERNAME=usuario_sql_server
KH_PASSWORD=password_sql_server

# Integración SQL Server futura: se rechaza KH_HE y se exige sufijo _test.
# SQLSERVER_TEST_DATABASE=KH_HE_test

# 3. Seguridad JWT y Sesiones Clínicas
SECRET_KEY=clave_secreta_super_segura_generada_criptograficamente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=hes-api
JWT_AUDIENCE=hes-clinical-clients

# 4. Firma Electrónica Avanzada (FEA) Criptográfica
HES_HMAC_SECRET=clave_hexadecimal_sha256_para_derivacion_kek_fea

# Secreto estable compartido con los agentes DigitalPersona de las estaciones.
# El servidor central no ejecuta el agente USB. Rotar coordinadamente en todos los puestos.
# Mínimo 32 caracteres; firma la attestation challenge/captura y nunca viaja al navegador.
BIOMETRIC_ATTESTATION_SECRET=secreto_aleatorio_independiente_de_32_caracteres_o_mas

# 5. Sellado de Tiempo RFC 3161 (TSA)
TSA_URL=https://freetsa.org/tsr
TSA_TIMEOUT=3
TSA_TRUST_STORE=/ruta/privada/tsa-trust-roots.pem
# Opcionales para fijar adicionalmente la identidad exacta de la TSA:
TSA_EXPECTED_SUBJECT=
TSA_EXPECTED_CERT_SHA256=

# 6. Integración API Vertical (ERP Hospitalario)
VERTICAL_ASPXAUTH=cookie_aspxauth_del_sistema_vertical
VERTICAL_SESSION_ID=session_id_del_sistema_vertical
VERTICAL_SYSTEM_USER=usuario_de_servicio_vertical
VERTICAL_SYSTEM_PASSWORD=clave_de_servicio_vertical

# 7. Restricción de Orígenes CORS y Hosts Permitidos (Seguridad Intranet)
ALLOWED_ORIGINS=https://192.168.254.249:8000
ALLOWED_HOSTS=192.168.254.249
# En production debe ser true y el proxy validado debe establecer X-Forwarded-Proto=https.
PROXY_HTTPS_ENABLED=false

# 8. Operación y almacenamiento privado
PRIVATE_STORAGE_ROOT=/var/lib/hes/private
# Dirección pública HTTPS que se codifica en los QR de verificación.
# Debe resolver desde Internet (también desde la casa del paciente), apuntar al
# proxy que publica /verificar y nunca ser localhost ni una IP privada.
PUBLIC_VERIFICATION_BASE_URL=
# Alias histórico aceptado durante la migración (si se usa, debe cumplir las mismas reglas).
VERIFICATION_BASE_URL=
MIN_FREE_DISK_BYTES=1073741824
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=5

# Sólo para HES Biometric Agent en cada estación cliente; no son servicios del servidor.
# El instalador configura este origen exacto y protege el secreto compartido con DPAPI.
BIOMETRIC_ALLOWED_ORIGINS=https://192.168.254.249:8000
BIOMETRIC_PORT=8082
