# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO (PLANTILLA .env.example) - MediReg HES
# ==============================================================================

# 1. Base de Datos Transaccional PostgreSQL Local
DATABASE_URL=postgresql://usuario:password@localhost:5432/hospital_escandon_db

# 2. Conexión Hospitalaria Externa (SQL Server KH_HE vía Tailscale Mesh VPN)
KH_SERVER=127.0.0.1,1433
KH_DATABASE=KH_HE
KH_USERNAME=usuario_sql_server
KH_PASSWORD=password_sql_server

# 3. Seguridad JWT y Sesiones Clínicas
SECRET_KEY=clave_secreta_super_segura_generada_criptograficamente
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. Firma Electrónica Avanzada (FEA) Criptográfica
HES_HMAC_SECRET=clave_hexadecimal_sha256_para_derivacion_kek_fea

# 5. Sellado de Tiempo RFC 3161 (TSA)
TSA_URL=https://freetsa.org/tsr
TSA_TIMEOUT=3

# 6. Integración API Vertical (ERP Hospitalario)
VERTICAL_ASPXAUTH=cookie_aspxauth_del_sistema_vertical
VERTICAL_SESSION_ID=session_id_del_sistema_vertical
VERTICAL_SYSTEM_USER=usuario_de_servicio_vertical
